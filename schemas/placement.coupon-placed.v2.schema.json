{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "CouponPlacedV2",
  "type": "object",
  "description": "A placed coupon with one or more bets over its legs.",
  "additionalProperties": false,
  "required": [
    "couponId",
    "punterId",
    "totalStake",
    "potentialPayout",
    "legs",
    "bets",
    "placedAt"
  ],
  "properties": {
    "couponId": {
      "type": "string",
      "format": "guid"
    },
    "punterId": {
      "type": "string",
      "format": "guid"
    },
    "totalStake": {
      "$ref": "#/definitions/Money"
    },
    "potentialPayout": {
      "$ref": "#/definitions/Money"
    },
    "legs": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/CouponLegV2"
      }
    },
    "bets": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/CouponBetV2"
      }
    },
    "placedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "definitions": {
    "Money": {
      "type": "object",
      "description": "An amount in minor units (cents) of an ISO 4217 currency.",
      "additionalProperties": false,
      "required": [
        "minorUnits",
        "currency"
      ],
      "properties": {
        "minorUnits": {
          "type": "integer",
          "format": "int64"
        },
        "currency": {
          "type": "string"
        }
      }
    },
    "CouponLegV2": {
      "type": "object",
      "description": "A leg of a V2 coupon. A banker is in every line of every bet on the coupon. A bet builder leg has market id\nMarketId, its components in Builder, and settles as one leg.\nThe display names (FixtureName \"Home v Away\", Competition, MarketType as the\noffer's camelCase market type, SelectionName) are copied from the offer at placement so bet history can\nshow a leg after its fixture leaves the offer. They are optional: events placed before 2.13.0 carry none.",
      "additionalProperties": false,
      "required": [
        "legId",
        "fixtureId",
        "marketId",
        "selectionId",
        "odds",
        "offerVersion",
        "isBanker"
      ],
      "properties": {
        "legId": {
          "type": "string",
          "format": "guid"
        },
        "fixtureId": {
          "type": "string"
        },
        "marketId": {
          "type": "string"
        },
        "selectionId": {
          "type": "string"
        },
        "odds": {
          "type": "number",
          "format": "decimal"
        },
        "offerVersion": {
          "type": "integer",
          "format": "int64"
        },
        "isBanker": {
          "type": "boolean"
        },
        "builder": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/definitions/BetBuilderLegV1"
            }
          ]
        },
        "fixtureName": {
          "type": [
            "null",
            "string"
          ]
        },
        "competition": {
          "type": [
            "null",
            "string"
          ]
        },
        "marketType": {
          "type": [
            "null",
            "string"
          ]
        },
        "selectionName": {
          "type": [
            "null",
            "string"
          ]
        }
      }
    },
    "BetBuilderLegV1": {
      "type": "object",
      "description": "The pricing inputs a bet builder leg was accepted on: its components, the correlation factor of every pair (keyed by\nPairKey) and the margin. Settlement reprices from these when a component is void.",
      "additionalProperties": false,
      "required": [
        "components",
        "pairFactors",
        "marginPercent"
      ],
      "properties": {
        "components": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/BuilderComponentV1"
          }
        },
        "pairFactors": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "format": "decimal"
          }
        },
        "marginPercent": {
          "type": "number",
          "format": "decimal"
        }
      }
    },
    "BuilderComponentV1": {
      "type": "object",
      "description": "One selection inside a bet builder, at the price it had on its own when the builder was priced.",
      "additionalProperties": false,
      "required": [
        "marketId",
        "selectionId",
        "odds"
      ],
      "properties": {
        "marketId": {
          "type": "string"
        },
        "selectionId": {
          "type": "string"
        },
        "odds": {
          "type": "number",
          "format": "decimal"
        }
      }
    },
    "CouponBetV2": {
      "type": "object",
      "description": "One bet on a coupon: every combination of each size in Folds taken from the non-banker legs, with the\nbankers added to each. A Trixie on three selections is folds [2, 3]; singles are [1]; an accumulator of n is [n].\nStake is UnitStake times Lines. AccaBoostPercent is the share of\nthe winnings settlement adds when the bet wins, fixed at placement (see AccaBoost).",
      "additionalProperties": false,
      "required": [
        "betId",
        "name",
        "folds",
        "lines",
        "unitStake",
        "stake",
        "potentialPayout",
        "accaBoostPercent"
      ],
      "properties": {
        "betId": {
          "type": "string",
          "format": "guid"
        },
        "name": {
          "type": "string"
        },
        "folds": {
          "type": "array",
          "items": {
            "type": "integer",
            "format": "int32"
          }
        },
        "lines": {
          "type": "integer",
          "format": "int32"
        },
        "unitStake": {
          "$ref": "#/definitions/Money"
        },
        "stake": {
          "$ref": "#/definitions/Money"
        },
        "potentialPayout": {
          "$ref": "#/definitions/Money"
        },
        "accaBoostPercent": {
          "type": "number",
          "format": "decimal"
        }
      }
    }
  }
}
