{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "ResultPublishedV1",
  "type": "object",
  "description": "A result; the score is goals, points, runs or (tennis) sets by sport, with Detail for the rest.",
  "additionalProperties": false,
  "required": [
    "fixtureId",
    "resultVersion",
    "status",
    "homeGoals",
    "awayGoals",
    "publishedAt"
  ],
  "properties": {
    "fixtureId": {
      "type": "string"
    },
    "resultVersion": {
      "type": "integer",
      "format": "int32"
    },
    "status": {
      "$ref": "#/definitions/ResultStatus"
    },
    "homeGoals": {
      "type": "integer",
      "format": "int32"
    },
    "awayGoals": {
      "type": "integer",
      "format": "int32"
    },
    "publishedAt": {
      "type": "string",
      "format": "date-time"
    },
    "detail": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/definitions/ResultDetailV1"
        }
      ]
    }
  },
  "definitions": {
    "ResultStatus": {
      "type": "string",
      "description": "Ordered by precedence: a higher value outranks a lower one at the same result version.",
      "x-enumNames": [
        "Provisional",
        "Official",
        "Correction",
        "Void"
      ],
      "enum": [
        "provisional",
        "official",
        "correction",
        "void"
      ]
    },
    "ResultDetailV1": {
      "type": "object",
      "description": "What a score alone cannot settle: tennis games (the score fields carry sets) and the winning selection ids of\nplayer and outright markets, such as the top batter or the competition winner.",
      "additionalProperties": false,
      "properties": {
        "homeGames": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int32"
        },
        "awayGames": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int32"
        },
        "winners": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
